APP_NAME="Moreta Barcode Scanner"
# Secure defaults. For local development set APP_ENV=local and APP_DEBUG=true.
# The app refuses to boot with APP_DEBUG=true while APP_ENV=production.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8003
FRONTEND_URL=http://localhost:5175
# Office LAN / VPN URL (Vite --host). Leave blank on machines that stay localhost-only.
LAN_FRONTEND_URL=
# Opt in to credentialed CORS for LAN IPs and share tunnels (ngrok, Cloudflare).
# Only honoured when APP_ENV=local. Needed to test scanning from a phone on the
# office LAN; keep false otherwise.
ALLOW_DEV_ORIGINS=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lst_tracc_sql_moreta
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_CONNECTION=lstv_dbsystem
SESSION_LIFETIME=120
SESSION_COOKIE=moreta_barcode_scanner_session
# Leave empty for mobile/LAN access (e.g. http://192.168.x.x:5175).
SESSION_DOMAIN=
# Set to true once the deployment terminates TLS. Leave false on a plain-HTTP
# LAN install: a Secure cookie is never sent over HTTP and login would fail.
# The camera API also needs HTTPS (or a Chrome insecure-origin exception).
SESSION_SECURE_COOKIE=false
# Add your PC LAN IP with port, e.g. 192.168.2.171:5175. Local dev also allows 192.168.* via config/sanctum.php.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5175,127.0.0.1,127.0.0.1:5175

# Same folder as moreta-2026/backend/storage/app/eir-uploads so desktop print can load the image.
EIR_UPLOADS_PATH=
